                     "name":  "02 Продукт за slug",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\u0027Статус 200\u0027, () =\u003e { pm.response.to.have.status(200); });",
                                                                   "pm.test(\u0027Формат JSON\u0027, () =\u003e { pm.expect(pm.response.headers.get(\u0027Content-Type\u0027)).to.include(\u0027application/json\u0027); });",
                                                                   "const body = pm.response.json();",
                                                                   "pm.test(\u0027Той самий slug, назва, ціна та категорія\u0027, () =\u003e {",
                                                                   "  const p = body.data;",
                                                                   "  pm.expect(p.slug).to.eql(pm.collectionVariables.get(\u0027known_slug\u0027));",
                                                                   "  pm.expect(p.title).to.be.a(\u0027string\u0027).and.not.empty;",
                                                                   "  pm.expect(p.price).to.match(/^\\d+\\.\\d{2}$/);",
                                                                   "  pm.expect(p.category).to.be.a(\u0027string\u0027).and.not.empty;",
                                                                   "  pm.expect(p.published_at).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                                                                   "});"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
