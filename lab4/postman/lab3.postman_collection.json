                     "name":  "01 Список продуктів",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\u0027Статус 200\u0027, () =\u003e { pm.response.to.have.status(200); });",
                                                                   "pm.test(\u0027Формат JSON\u0027, () =\u003e { pm.expect(pm.response.headers.get(\u0027Content-Type\u0027)).to.include(\u0027application/json\u0027); });",
                                                                   "const body = pm.response.json();",
                                                                   "pm.test(\u0027Перші 9 продуктів із 12\u0027, () =\u003e {",
                                                                   "  pm.expect(body.data).to.be.an(\u0027array\u0027).with.lengthOf(9);",
                                                                   "  pm.expect(body.meta.total).to.eql(12);",
                                                                   "});",
                                                                   "pm.test(\u0027Є links і meta\u0027, () =\u003e {",
                                                                   "  pm.expect(body).to.have.property(\u0027links\u0027);",
                                                                   "  pm.expect(body.meta).to.have.property(\u0027current_page\u0027, 1);",
                                                                   "});",
                                                                   "const first = body.data[0];",
                                                                   "pm.collectionVariables.set(\u0027known_slug\u0027, first.slug);",
                                                                   "pm.collectionVariables.set(\u0027category\u0027, first.category);",
                                                                   "pm.collectionVariables.set(\u0027operation\u0027, first.operation);",
                                                                   "pm.collectionVariables.set(\u0027search\u0027, first.title);"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
